# Smart Office Document Assistant — environment variable names only.
# NEVER put real values here. Copy to .env.local (git-ignored) and fill in for
# local development. These are read server-side only, via src/lib/env.ts.
# No NEXT_PUBLIC_ secrets.

N8N_BASE_URL=

# Workflow A (upload), Workflow B (documents list) and Workflow C (review).
# The secret is sent as the x-api-key header on all three.
N8N_PROCESS_PATH=
N8N_DOCUMENTS_PATH=
N8N_REVIEW_PATH=
N8N_SECRET=
