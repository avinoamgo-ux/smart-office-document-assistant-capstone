      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst isObject = body !== null && typeof body === 'object' && !Array.isArray(body);\nconst id = isObject ? body.document_id : undefined;\nconst status = isObject ? body.status : undefined;\nconst reviewer = isObject ? body.reviewed_by : undefined;\nconst notePresent = isObject && Object.prototype.hasOwnProperty.call(body, 'review_note');\nconst note = notePresent ? body.review_note : undefined;\nconst valid = typeof id === 'string' && id.length > 0\n  && (status === 'Reviewed' || status === 'Needs Review')\n  && typeof reviewer === 'string' && reviewer.length > 0\n  && (!notePresent || (typeof note === 'string' && note.length <= 200));\nreturn [{ json: {\n  valid,\n  document_id: valid ? id : null,\n  status: valid ? status : null,\n  reviewed_by: valid ? reviewer : null,\n  note_present: notePresent,\n  review_note: valid && notePresent ? note : null,\n} }];"
      },
