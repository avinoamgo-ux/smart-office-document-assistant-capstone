        "jsCode": "const request = $('Code in JavaScript').first().json;\nconst rows = $input.all().map(item => item.json).filter(row => row && Object.keys(row).length > 0).filter(row => String(row['Document ID']) === request.document_id);\nconst route = rows.length === 0 ? 'not_found' : rows.length === 1 ? 'found' : 'duplicate';\nconst row = rows.length === 1 ? rows[0] : null;\nreturn [{ json: {\n  route,\n  match_count: rows.length,\n  document_id: request.document_id,\n  status: request.status,\n  reviewed_by: request.reviewed_by,\n  review_note: request.note_present ? request.review_note : (row ? row['Review Note'] ?? '' : ''),\n  row_number: row ? row.row_number ?? null : null,\n} }];"
